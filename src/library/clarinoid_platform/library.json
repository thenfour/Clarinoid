{
    "name": "clarinoid",
    "version": "0.1.0",
    "description": "Clarinoid common helpers: math, formatting, gfx, etc.",
    "authors": [
        {
            "name": "Your Name",
            "email": "you@example.com"
        }
    ],
    "keywords": [
        "clarinoid",
        "math",
        "format",
        "gfx"
    ],
    "license": "MIT",
    "build": {
        "includeDir": "src", // public headers
        "srcFilter": [
            "+<src/>", // compile everything under src/
            "-<*/tests/>" // exclude unit-tests if present
        ],
        "headersOnly": false // set true if you ship only headers
    },
    "frameworks": [
        "arduino"
    ], // adjust as needed
    "platforms": [
        "teensy",
        "native"
    ],
    "dependencies": [
        // example: other libs you rely on
        // { "name": "FastLED", "version": ">=3.5.0" }
    ]
}